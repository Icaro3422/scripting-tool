# Database (Podman/PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scripting_tool"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Clerk webhooks (future wallets)
# CLERK_WEBHOOK_SECRET=

# YouTube Data API v3 (canal analysis)
YOUTUBE_API_KEY=

# AI Providers (use the ones you need)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=

# OpenRouter: un solo API key para 400+ modelos (gratis y de pago). Ver https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# Storage: Vercel Blob (recommended for hobby / free tier)
BLOB_READ_WRITE_TOKEN=

# OpenRouter: clave de gestión (analytics / actividad por modelo). Opcional. Ver documentación OpenRouter → Analytics.
OPENROUTER_MANAGEMENT_KEY=

# Storage: Cloudinary para miniaturas en la nube (o usa modo Local en la app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face (TTS / voices)
HUGGINGFACE_API_KEY=

# Facturación: si true, descuenta del balance al usar IA. Si false, solo registra uso.
BILLING_ENABLED=false
# Groq: proveedor alternativo para generación de prompts de imagen
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BATCH_SIZE=8

# Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenRouter: configuración adicional
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=Scripting Tool

# Límites de generación de prompts
MAX_PROMPT_FRAGMENTS_PER_REQUEST=32
MAX_PROMPT_FRAGMENT_TEXT_LENGTH=4000
MAX_PROMPT_TOTAL_FRAGMENT_CHARS=20000

# App URL (para fallback en servicios)
NEXT_PUBLIC_APP_URL=http://localhost:3001
